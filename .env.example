# Copy this file to `.env` for local development (`vercel dev` reads it).
# In production, set these as Environment Variables in the Vercel project
# dashboard (Settings → Environment Variables) instead. Never commit a real
# `.env` file or expose the CJ API key in browser code.

# Required for the live CJdropshipping catalogue.
CJ_API_KEY=

# Optional: CJ API origin (defaults to the official developer endpoint).
CJ_API_ORIGIN=https://developers.cjdropshipping.com

# Optional: country code used when searching for CJ inventory (for example IN, US, GB, AU).
CJ_DEFAULT_COUNTRY=IN

# Optional retail pricing rule. The browser receives only this calculated retail price.
# Keep both at the defaults until you have approved your own pricing strategy.
CJ_RETAIL_MULTIPLIER=1
CJ_RETAIL_FIXED_MARGIN=0
